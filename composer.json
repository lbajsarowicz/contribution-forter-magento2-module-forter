{
    "name": "forter/magento2-module-forter",
    "description": "Forter Fraud Prevention For Magento 2",
    "require": {
        "php": "~7.4.0||~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "ext-json": "*",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.3.0"
    },
    "type": "magento2-module",
    "license": [
        "proprietary"
    ],
    "version": "2.5.38",
    "authors": [{
        "name": "Forter Dev",
        "email": "support@forter.com",
        "role": "Developer",
        "homepage": "https://www.forter.com/"
    }],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Forter\\Forter\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
